"""
Goal:
1. Load one clean speech recording.
2. Understand sampling rate, samples, duration, and waveform.
3. Add one short impulsive noise at a known time.
4. Save and compare the clean and noisy recordings.

"""

# %% Step 1: Import the libraries

from pathlib import Path

import matplotlib.pyplot as plt
import numpy as np
from scipy.io import wavfile


# %% Step 2: Choose the input and output files

# Put a mono or stereo WAV file at audio/clean_speech.wav.
INPUT_FILE = Path("audio/clean_speech.wav")
OUTPUT_FILE = Path("audio/speech_with_impulse.wav")

# We will create a short sudden noise at 2 seconds.
IMPULSE_TIME_SECONDS = 2.0
IMPULSE_DURATION_SECONDS = 0.02
IMPULSE_AMPLITUDE = 0.7


# %% Step 3: Load the audio

sample_rate, audio = wavfile.read(INPUT_FILE)

# If the recording is stereo, average the two channels to make it mono.
if audio.ndim == 2:
    audio = audio.mean(axis=1)

# WAV files are often stored as integers. Convert them to values near -1 to 1.
if np.issubdtype(audio.dtype, np.integer):
    maximum_integer = max(abs(np.iinfo(audio.dtype).min), np.iinfo(audio.dtype).max)
    audio = audio.astype(np.float64) / maximum_integer
else:
    audio = audio.astype(np.float64)


# %% Step 4: Calculate basic audio information

number_of_samples = len(audio)
duration_seconds = number_of_samples / sample_rate
time = np.arange(number_of_samples) / sample_rate

print(f"Sampling rate: {sample_rate} Hz")
print(f"Number of samples: {number_of_samples}")
print(f"Duration: {duration_seconds:.2f} seconds")


# %% Step 5: Plot the clean speech waveform

plt.figure(figsize=(12, 4))
plt.plot(time, audio, linewidth=0.7)
plt.xlabel("Time (seconds)")
plt.ylabel("Amplitude")
plt.title("Clean speech waveform")
plt.tight_layout()
plt.show()


# %% Step 6: Add one short impulsive noise

if IMPULSE_TIME_SECONDS >= duration_seconds:
    raise ValueError("IMPULSE_TIME_SECONDS must be shorter than the audio duration.")

start_sample = int(IMPULSE_TIME_SECONDS * sample_rate)
impulse_length = int(IMPULSE_DURATION_SECONDS * sample_rate)
end_sample = min(start_sample + impulse_length, number_of_samples)

# Use a fixed seed so that the same noise is generated every time.
random_generator = np.random.default_rng(5305)
impulse = random_generator.standard_normal(end_sample - start_sample)

# A Hann window gives the short noise a clear beginning and end.
impulse = impulse * np.hanning(len(impulse))
impulse = IMPULSE_AMPLITUDE * impulse / np.max(np.abs(impulse))

noisy_audio = audio.copy()
noisy_audio[start_sample:end_sample] += impulse
noisy_audio = np.clip(noisy_audio, -1.0, 1.0)


# %% Step 7: Compare the clean and noisy waveforms

figure, axes = plt.subplots(2, 1, figsize=(12, 7), sharex=True)

axes[0].plot(time, audio, linewidth=0.7)
axes[0].set_title("Clean speech")
axes[0].set_ylabel("Amplitude")

axes[1].plot(time, noisy_audio, linewidth=0.7)
axes[1].axvspan(
    IMPULSE_TIME_SECONDS,
    IMPULSE_TIME_SECONDS + IMPULSE_DURATION_SECONDS,
    color="red",
    alpha=0.25,
    label="Added impulsive noise",
)
axes[1].set_title("Speech with one short impulsive noise")
axes[1].set_xlabel("Time (seconds)")
axes[1].set_ylabel("Amplitude")
axes[1].legend()

figure.tight_layout()
plt.show()


# %% Step 8: Zoom in around the impulsive noise

zoom_start = max(0.0, IMPULSE_TIME_SECONDS - 0.10)
zoom_end = min(duration_seconds, IMPULSE_TIME_SECONDS + 0.12)
zoom_mask = (time >= zoom_start) & (time <= zoom_end)

plt.figure(figsize=(12, 4))
plt.plot(time[zoom_mask], audio[zoom_mask], label="Clean speech", linewidth=1.0)
plt.plot(
    time[zoom_mask],
    noisy_audio[zoom_mask],
    label="Speech with impulse",
    linewidth=1.0,
    alpha=0.8,
)
plt.xlabel("Time (seconds)")
plt.ylabel("Amplitude")
plt.title("Zoomed waveform around the impulsive noise")
plt.legend()
plt.tight_layout()
plt.show()


# %% Step 9: Save the noisy recording

OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)
wavfile.write(OUTPUT_FILE, sample_rate, (noisy_audio * 32767).astype(np.int16))

print(f"Saved noisy recording to: {OUTPUT_FILE}")
